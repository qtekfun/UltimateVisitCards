<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada va a la copia en la nube ni a la transferencia entre dispositivos.
     La copia de seguridad es la propia de la app (Ajustes → Copia de seguridad). -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
